<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.controller.PizzaController" spacing="12">
  <HBox spacing="8"><TextField fx:id="nameField" promptText="Nama (VolcanoMeat/CheeseMania)"/><TextField fx:id="sizeField" promptText="Ukuran"/><TextField fx:id="priceField" promptText="Harga"/></HBox>
  <HBox spacing="8"><Button text="Tambah" onAction="#add"/><Button text="Ubah" onAction="#update"/><Button text="Hapus" onAction="#delete"/><Button text="Bersihkan" onAction="#clear"/></HBox>
  <TableView fx:id="pizzaTable" VBox.vgrow="ALWAYS">
    <columns>
      <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
      <TableColumn fx:id="nameColumn" text="Nama Pizza" prefWidth="200"/>
      <TableColumn fx:id="sizeColumn" text="Ukuran" prefWidth="130"/>
      <TableColumn fx:id="priceColumn" text="Harga" prefWidth="150"/>
    </columns>
  </TableView>
</VBox>
