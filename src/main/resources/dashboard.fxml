<!-- Import padding, kontrol navigasi, dan layout. -->
<?import javafx.geometry.Insets?>
<!-- Mengimpor kontrol navigasi, label, separator, dan tab. -->
<?import javafx.scene.control.*?>
<!-- Mengimpor VBox, HBox, dan Region sebagai kontainer. -->
<?import javafx.scene.layout.*?>

<!-- HBox membagi dashboard menjadi sidebar navigasi dan TabPane konten. -->
<HBox prefHeight="650" prefWidth="1100" styleClass="admin-shell" stylesheets="@css/style.css"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="main.java.controller.DashboardController">
    <VBox spacing="16" styleClass="admin-sidebar" prefWidth="270">
        <!-- Tombol sidebar membuka halaman admin melalui DashboardController. -->
        <!-- Identitas aplikasi pada sidebar. -->
        <Label text="PUZIZA ADMIN" styleClass="admin-brand-title"/>
        <!-- Pemisah area merek dan menu navigasi. -->
        <Separator/>
        <!-- Tombol menu membuka tab pengelolaan pizza. -->
        <Button text="Manage Pizza" maxWidth="Infinity" styleClass="admin-nav-button" onAction="#showPizzaView"/>
        <!-- Tombol menu membuka tab customer. -->
        <Button text="Manage Customer" maxWidth="Infinity" styleClass="admin-nav-button" onAction="#showCustomerView"/>
        <!-- Tombol menu membuka tab kasir. -->
        <Button text="Manage Cashier" maxWidth="Infinity" styleClass="admin-nav-button" onAction="#showCashierView"/>
        <!-- Tombol menu membuka tab riwayat penjualan. -->
        <Button text="Manage Sales" maxWidth="Infinity" styleClass="admin-nav-button" onAction="#showSalesView"/>
        <!-- Area fleksibel mendorong informasi pengguna dan Logout ke bagian bawah. -->
        <Region VBox.vgrow="ALWAYS"/>
        <!-- Memisahkan navigasi dari identitas pengguna dan tombol keluar. -->
        <Separator/>
        <Label fx:id="adminUserLabel" text="Hi, Administrator" styleClass="admin-user"/>
        <Button text="Logout" maxWidth="Infinity" styleClass="admin-logout-button" onAction="#logout"/>
    <!-- Menutup sidebar dashboard. -->
    </VBox>
    <!-- Controller menambahkan halaman pizza/customer/kasir/penjualan sebagai tab. -->
    <TabPane fx:id="mainTabPane" styleClass="admin-tab-pane" HBox.hgrow="ALWAYS" tabClosingPolicy="ALL_TABS"/>
</HBox>
