<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane stylesheets="@css/style.css" xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.controller.LoginController">
    <GridPane alignment="CENTER" hgap="10" vgap="15" styleClass="login-container" maxWidth="380" maxHeight="340">
        <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
        <Label text="Admin Login" style="-fx-font-size: 22px; -fx-font-weight: bold;" GridPane.columnSpan="2" GridPane.halignment="CENTER"/>
        <Label text="Username:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="usernameField" promptText="Enter username" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Password:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <PasswordField fx:id="passwordField" promptText="Enter password" onAction="#handleLogin" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Button text="Sign In" onAction="#handleLogin" styleClass="button-primary" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnSpan="2"/>
        <Label fx:id="errorLabel" styleClass="error-text" wrapText="true" GridPane.rowIndex="4" GridPane.columnSpan="2" GridPane.halignment="CENTER"/>
        <Button text="Back" onAction="#backToWelcome" styleClass="button-secondary" GridPane.rowIndex="5" GridPane.columnSpan="2" maxWidth="Infinity"/>
    </GridPane>
</StackPane>
