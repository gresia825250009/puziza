<?xml version="1.0" encoding="UTF-8"?>
<!--
  File: login.fxml
  Deskripsi: Tampilan form login admin atau kasir.
  @author Gresia Valerina Widi
  @author Garneta Auril Triasis
-->

<!-- Import padding, kontrol form, dan layout JavaFX. -->
<?import javafx.geometry.Insets?>
<!-- Mengimpor Label, TextField, PasswordField, dan Button. -->
<?import javafx.scene.control.*?>
<!-- Mengimpor StackPane dan GridPane untuk posisi form login. -->
<?import javafx.scene.layout.*?>

<!-- Layar login menghubungkan input dan tombol ke LoginController. -->
<StackPane styleClass="login-screen" stylesheets="@css/style.css" xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="main.java.controller.LoginController">
    <!-- GridPane menyusun label dan input dalam baris/kolom. -->
    <GridPane alignment="CENTER" hgap="10" vgap="15" styleClass="login-container" maxWidth="380" maxHeight="360">
        <!-- Ruang dalam kartu login. -->
        <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
        <Label text="Admin Login" styleClass="login-title" GridPane.columnSpan="2" GridPane.halignment="CENTER"/>
        <Label text="Username:" styleClass="grid-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <!-- Field ini dihubungkan lewat fx:id; passwordField juga dapat men-submit dengan Enter. -->
        <TextField fx:id="usernameField" promptText="Enter username" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <!-- Label dan field password untuk kredensial kasir/admin. -->
        <Label text="Password:" styleClass="grid-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <PasswordField fx:id="passwordField"
                       promptText="Enter password"
                       onAction="#handleLogin"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="1"/>
        <!-- Tombol login memanggil autentikasi; errorLabel menampilkan pesan hasil proses. -->
        <Button text="Sign In"
                onAction="#handleLogin"
                styleClass="button-primary"
                maxWidth="Infinity"
                GridPane.rowIndex="3"
                GridPane.columnSpan="2"/>
        <!-- Label ini diisi pesan kesalahan login oleh controller. -->
        <Label fx:id="errorLabel"
               styleClass="error-text"
               wrapText="true"
               GridPane.rowIndex="4"
               GridPane.columnSpan="2"
               GridPane.halignment="CENTER"/>
        <Button text="Back"
                onAction="#backToWelcome"
                styleClass="button-secondary"
                GridPane.rowIndex="5"
                GridPane.columnSpan="2"
                maxWidth="Infinity"/>
        <!-- Menutup susunan form login. -->
    </GridPane>
<!-- Menutup layar login. -->
</StackPane>
